+<template>
+  <div>
+    <div class="row items-center q-mb-md">
+      <div class="text-subtitle1">Position as at {{ data?.today }}</div>
+      <q-space />
+      <q-btn flat dense no-caps icon="refresh" label="Refresh" :loading="loading" @click="load" />
+    </div>
+
+    <q-banner v-if="data && !data.vat.registered" dense rounded class="bg-orange-1 text-dark q-mb-md">
+      <template #avatar><q-icon name="info" color="orange" /></template>
+      No VAT number is set (Settings &rarr; company VAT), so VAT on expenses and bills is not claimed.
+      VAT on sales is still reported from each invoice's tax rate.
+    </q-banner>
+    <q-banner v-if="data?.lockDate" dense rounded class="bg-blue-1 text-dark q-mb-md">
+      <template #avatar><q-icon name="lock" color="primary" /></template>
+      Books are closed up to {{ data.lockDate }}. Nothing on or before that date can be changed.
+    </q-banner>
+
+    <div v-if="data" class="row q-col-gutter-md">
+      <div v-for="card in cards" :key="card.label" class="col-12 col-sm-6 col-md-4">
+        <q-card flat bordered class="full-height">
+          <q-card-section>
+            <div class="text-caption text-grey">{{ card.label }}</div>
+            <div class="text-h5" :class="card.negative ? 'text-negative' : ''">{{ format(card.value) }}</div>
+            <div v-if="card.hint" class="text-caption text-grey q-mt-xs">{{ card.hint }}</div>
+          </q-card-section>
+        </q-card>
+      </div>
+    </div>
+
+    <div v-if="data" class="row q-col-gutter-md q-mt-sm">
+      <div v-for="p in periods" :key="p.title" class="col-12 col-md-6">
+        <q-card flat bordered>
+          <q-card-section>
+            <div class="text-subtitle2 q-mb-sm">{{ p.title }}</div>
+            <q-markup-table flat dense separator="none">
+              <tbody>
+                <tr><td>Sales (excl. VAT)</td><td class="text-right">{{ format(p.v.sales) }}</td></tr>
+                <tr><td>Cost of sales</td><td class="text-right">{{ format(p.v.cogs) }}</td></tr>
+                <tr><td>Expenses</td><td class="text-right">{{ format(p.v.expenses) }}</td></tr>
+                <tr class="text-weight-bold">
+                  <td>Net profit</td>
+                  <td class="text-right" :class="p.v.profit < 0 ? 'text-negative' : 'text-positive'">{{ format(p.v.profit) }}</td>
+                </tr>
+              </tbody>
+            </q-markup-table>
+          </q-card-section>
+        </q-card>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed, onMounted } from 'vue';
+import AccountingRepository from 'src/services/repositories/AccountingRepository';
+import { useCurrency } from 'src/composables/useCurrency';
+import { useAccountingUi } from 'src/composables/useAccountingUi';
+
+const { format } = useCurrency();
+const { fail } = useAccountingUi();
+const data = ref(null);
+const loading = ref(false);
+
+const cards = computed(() => {
+  const d = data.value;
+  if (!d) return [];
+  return [
+    { label: 'Money on hand', value: d.cash.total, hint: `Cash ${format(d.cash.cash)} - Bank ${format(d.cash.bank)} - Mobile money ${format(d.cash.mobileMoney)}`, negative: d.cash.total < 0 },
+    { label: 'Owed to you (receivables)', value: d.receivables },
+    { label: 'You owe (payables)', value: d.payables },
+    { label: d.vatPayable >= 0 ? 'VAT payable (all time)' : 'VAT refundable (all time)', value: Math.abs(d.vatPayable) },
+    { label: 'Inventory (ledger)', value: d.inventory, hint: 'Post opening stock in Journal if this looks low.' },
+  ];
+});
+const periods = computed(() =>
+  data.value ? [{ title: 'This month', v: data.value.month }, { title: 'This year', v: data.value.year }] : [],
+);
+
+async function load() {
+  loading.value = true;
+  try {
+    data.value = await AccountingRepository.overview();
+  } catch (err) {
+    fail(err);
+  } finally {
+    loading.value = false;
+  }
+}
+onMounted(load);
+</script>
diff --git a/src/components/accounting/ReceivablesTab.vue b/src/components/accounting/ReceivablesTab.vue
new file mode 100644
index 0000000..0c4fa15
--- /dev/null
+++ b/src/components/accounting/ReceivablesTab.vue
@@ -0,0 +1,140 @@
+<template>
+  <div>
+    <div class="row items-center q-mb-sm">
+      <div class="text-subtitle1">Unpaid customer invoices</div>
+      <q-space />
+      <ExportMenu :table="agingTable" label="Export aging" file-name="customer-aging" />
+    </div>
+    <q-table flat bordered dense :rows="rows" :columns="columns" row-key="id" :loading="loading"
+      :pagination="{ rowsPerPage: 15 }" no-data-label="Nothing owed - every invoice is paid.">
+      <template #body-cell-actions="props">
+        <q-td :props="props">
+          <q-btn dense unelevated color="primary" no-caps icon="payments" label="Receive payment" @click="openPay(props.row)" />
+        </q-td>
+      </template>
+    </q-table>
+    <div class="text-caption text-grey q-mt-xs">
+      POS sales are paid at the till and never appear here. Total owed: <strong>{{ format(owed) }}</strong>
+    </div>
+
+    <div class="text-subtitle1 q-mt-lg q-mb-sm">Payments received</div>
+    <q-table flat bordered dense :rows="payments" :columns="payColumns" row-key="id" :pagination="{ rowsPerPage: 10 }"
+      no-data-label="No payments recorded yet.">
+      <template #body-cell-actions="props">
+        <q-td :props="props"><q-btn dense flat round icon="delete" color="negative" @click="removePayment(props.row)" /></q-td>
+      </template>
+    </q-table>
+
+    <q-dialog v-model="showPay">
+      <q-card style="min-width: 420px">
+        <q-card-section class="text-h6">Receive payment</q-card-section>
+        <q-card-section class="q-gutter-sm">
+          <div class="text-body2">
+            {{ target?.number }} &middot; {{ target?.customer_name || 'No customer' }}<br />
+            Balance owing: <strong>{{ format(target?.balance) }}</strong>
+          </div>
+          <q-input v-model.number="form.amount" type="number" min="0" step="0.01" label="Amount *" filled autofocus />
+          <q-select v-model="form.method" :options="PAYMENT_METHODS" option-value="value" option-label="label" emit-value
+            map-options label="Method" filled />
+          <q-input v-model="form.paidAt" type="date" label="Date" filled />
+          <q-input v-model="form.reference" label="Reference (optional)" filled />
+        </q-card-section>
+        <q-card-actions align="right">
+          <q-btn flat label="Cancel" v-close-popup />
+          <q-btn color="primary" label="Save payment" :loading="saving" @click="savePayment" />
+        </q-card-actions>
+      </q-card>
+    </q-dialog>
+  </div>
+</template>
+
+<script setup>
+import { ref, computed, onMounted } from 'vue';
+import AccountingRepository from 'src/services/repositories/AccountingRepository';
+import { PAYMENT_METHODS, paymentLabel } from 'src/constants/payments';
+import { useCurrency } from 'src/composables/useCurrency';
+import { useAccountingUi, localISO } from 'src/composables/useAccountingUi';
+import ExportMenu from './ExportMenu.vue';
+
+const { format } = useCurrency();
+const { ok, fail, confirm } = useAccountingUi();
+
+const rows = ref([]);
+const payments = ref([]);
+const loading = ref(false);
+const saving = ref(false);
+const showPay = ref(false);
+const target = ref(null);
+const form = ref({ amount: 0, method: 'cash', paidAt: localISO(), reference: '' });
+
+const owed = computed(() => rows.value.reduce((s, r) => s + r.balance, 0));
+const money = (key) => (r) => format(r[key]);
+const columns = [
+  { name: 'customer', label: 'Customer', field: (r) => r.customer_name || '-', align: 'left', sortable: true },
+  { name: 'number', label: 'Invoice', field: 'number', align: 'left', sortable: true },
+  { name: 'date', label: 'Date', field: 'date', align: 'left', sortable: true },
+  { name: 'days', label: 'Days', field: 'days', align: 'right', sortable: true },
+  { name: 'total', label: 'Total', field: money('total'), align: 'right' },
+  { name: 'paid', label: 'Paid', field: money('paid'), align: 'right' },
+  { name: 'balance', label: 'Balance', field: money('balance'), align: 'right' },
+  { name: 'actions', label: '', field: 'id', align: 'right' },
+];
+const payColumns = [
+  { name: 'paid_at', label: 'Date', field: 'paid_at', align: 'left', sortable: true },
+  { name: 'invoice', label: 'Invoice', field: 'invoice_number', align: 'left' },
+  { name: 'customer', label: 'Customer', field: (r) => r.customer_name || '-', align: 'left' },
+  { name: 'method', label: 'Method', field: (r) => paymentLabel(r.method), align: 'left' },
+  { name: 'reference', label: 'Reference', field: (r) => r.reference || '', align: 'left' },
+  { name: 'amount', label: 'Amount', field: money('amount'), align: 'right' },
+  { name: 'actions', label: '', field: 'id', align: 'right' },
+];
+
+const agingTable = () => AccountingRepository.report('arAging', { asOf: localISO() });
+
+async function load() {
+  loading.value = true;
+  try {
+    [rows.value, payments.value] = await Promise.all([
+      AccountingRepository.openInvoices({ asOf: localISO() }),
+      AccountingRepository.customerPayments({}),
+    ]);
+  } catch (err) {
+    fail(err);
+  } finally {
+    loading.value = false;
+  }
+}
+
+function openPay(row) {
+  target.value = row;
+  form.value = { amount: row.balance, method: 'cash', paidAt: localISO(), reference: '' };
+  showPay.value = true;
+}
+
+async function savePayment() {
+  saving.value = true;
+  try {
+    await AccountingRepository.recordCustomerPayment({ transactionId: target.value.id, ...form.value });
+    showPay.value = false;
+    ok('Payment recorded');
+    await load();
+  } catch (err) {
+    fail(err);
+  } finally {
+    saving.value = false;
+  }
+}
+
+async function removePayment(row) {
+  if (!(await confirm(`Delete the ${format(row.amount)} payment on ${row.invoice_number}?`))) return;
+  try {
+    await AccountingRepository.deleteCustomerPayment(row.id);
+    ok('Payment deleted');
+    await load();
+  } catch (err) {
+    fail(err);
+  }
+}
+
+onMounted(load);
+</script>
