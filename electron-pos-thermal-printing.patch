diff --git a/src/services/thermal/templates.js b/src/services/thermal/templates.js
new file mode 100644
index 0000000..048638c
--- /dev/null
+++ b/src/services/thermal/templates.js
@@ -0,0 +1,335 @@
+/**
+ * Thermal (58 / 80 mm) receipt templates for electron-pos-printer.
+ *
+ * Pure functions with no Electron / Node imports, so they run in the renderer.
+ * Each builder returns the `data` array that PosPrinter.print() expects; the
+ * Electron main process only has to hand that array to the library.
+ *
+ * Prices are TAX-INCLUSIVE (same rule as TransactionForm / repositories.js):
+ * line total = qty * unit_price - line discount. VAT is shown as "included".
+ */
+
+export const THERMAL_TEMPLATES = [
+  {
+    value: 'compact',
+    label: 'Compact',
+    hint: 'Company, items, total. Short and saves paper.',
+  },
+  {
+    value: 'detailed',
+    label: 'Detailed',
+    hint: 'Company details, customer, item columns, discount and VAT lines, barcode.',
+  },
+];
+
+export const THERMAL_PAPER_WIDTHS = [
+  { value: '80mm', label: '80 mm' },
+  { value: '58mm', label: '58 mm' },
+];
+
+const DOC_LABELS = {
+  quote: 'QUOTATION',
+  invoice: 'INVOICE',
+  purchase_order: 'PURCHASE ORDER',
+};
+
+/** Text values are rendered as HTML by the library, so escape user data. */
+function esc(value) {
+  return String(value ?? '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+function text(value, style = {}) {
+  return { type: 'text', value: esc(value), style };
+}
+
+function cell(value, style = {}) {
+  return { type: 'text', value: esc(value), style };
+}
+
+function divider(dashed = true) {
+  return {
+    type: 'text',
+    value: '&nbsp;',
+    style: {
+      borderTop: `1px ${dashed ? 'dashed' : 'solid'} #000`,
+      fontSize: '2px',
+      lineHeight: '2px',
+      margin: '4px 0',
+    },
+  };
+}
+
+function spacer(px = 8) {
+  return { type: 'text', value: '&nbsp;', style: { fontSize: `${px}px`, lineHeight: `${px}px` } };
+}
+
+function pick(obj, ...keys) {
+  for (const key of keys) {
+    const v = obj?.[key];
+    if (v !== undefined && v !== null && String(v).trim() !== '') return v;
+  }
+  return '';
+}
+
+function formatDate(value) {
+  const d = value ? new Date(value) : new Date();
+  if (Number.isNaN(d.getTime())) return '';
+  // 'YYYY-MM-DD' from the date picker is parsed as UTC; read it as a local date instead
+  const dateOnly = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || '').trim());
+  const local = dateOnly ? new Date(Number(dateOnly[1]), Number(dateOnly[2]) - 1, Number(dateOnly[3])) : d;
+  const dd = String(local.getDate()).padStart(2, '0');
+  const mm = String(local.getMonth() + 1).padStart(2, '0');
+  return `${dd}/${mm}/${local.getFullYear()}`;
+}
+
+function formatTime(value) {
+  const d = value ? new Date(value) : new Date();
+  if (Number.isNaN(d.getTime())) return '';
+  return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
+}
+
+function qtyText(q) {
+  const n = Number(q);
+  return Number.isFinite(n) ? String(Number(n.toFixed(4))) : String(q ?? '');
+}
+
+/** Normalise the document and compute totals (tax-inclusive). */
+export function computeThermalTotals(items) {
+  let gross = 0;
+  let discount = 0;
+  let total = 0;
+  let vat = 0;
+  const lines = items.map((item) => {
+    const qty = Number(item.quantity) || 0;
+    const price = Number(item.unit_price) || 0;
+    const discPct = Number(item.discount_pct) || 0;
+    const taxRate = Number(item.tax_rate) || 0;
+    const base = qty * price;
+    const disc = base * (discPct / 100);
+    const net = base - disc;
+    gross += base;
+    discount += disc;
+    total += net;
+    vat += taxRate > 0 ? (net * taxRate) / (100 + taxRate) : 0;
+    return { name: item.name || 'Item', qty, price, discPct, net };
+  });
+  return { lines, gross, discount, total, vat };
+}
+
+function companyBlock(company) {
+  return {
+    name: pick(company, 'company_name', 'name') || 'My Business',
+    address: pick(company, 'company_address', 'address'),
+    phone: pick(company, 'company_phone', 'phone'),
+    email: pick(company, 'company_email', 'email'),
+    vat: pick(company, 'company_vat', 'vat_number', 'vat', 'tax_number'),
+    footer: pick(company, 'receipt_footer', 'footer_note', 'document_footer') || 'Thank you for your business!',
+  };
+}
+
+/* ------------------------------------------------------------------------- */
+/* Template 1: compact                                                       */
+/* ------------------------------------------------------------------------- */
+
+function buildCompact(doc, company, { paper, formatMoney }) {
+  const base = paper === '58mm' ? 11 : 12;
+  const co = companyBlock(company);
+  const t = computeThermalTotals(doc.items);
+  const data = [];
+
+  data.push(text(co.name, { fontWeight: '700', textAlign: 'center', fontSize: `${base + 4}px` }));
+  if (co.address) data.push(text(co.address, { textAlign: 'center', fontSize: `${base - 2}px` }));
+  if (co.phone) data.push(text(`Tel: ${co.phone}`, { textAlign: 'center', fontSize: `${base - 2}px` }));
+  data.push(divider());
+  data.push(text(`${doc.label} ${doc.number}`, { fontWeight: '700', textAlign: 'center', fontSize: `${base}px` }));
+  data.push(text(`${doc.date} ${doc.time}`, { textAlign: 'center', fontSize: `${base - 2}px` }));
+  data.push(divider());
+
+  data.push({
+    type: 'table',
+    style: { border: 'none', width: '100%' },
+    tableBody: t.lines.map((l) => [
+      cell(`${qtyText(l.qty)} x ${l.name}${l.discPct ? ` (-${l.discPct}%)` : ''}`, {
+        textAlign: 'left',
+        fontSize: `${base}px`,
+      }),
+      cell(formatMoney(l.net), { textAlign: 'right', fontSize: `${base}px`, whiteSpace: 'nowrap' }),
+    ]),
+    tableBodyStyle: { border: 'none', padding: '1px 0' },
+  });
+
+  data.push(divider());
+  data.push({
+    type: 'table',
+    style: { border: 'none', width: '100%' },
+    tableBody: [
+      [
+        cell('TOTAL', { fontWeight: '700', fontSize: `${base + 3}px`, textAlign: 'left' }),
+        cell(formatMoney(t.total), { fontWeight: '700', fontSize: `${base + 3}px`, textAlign: 'right' }),
+      ],
+    ],
+    tableBodyStyle: { border: 'none' },
+  });
+  data.push(divider());
+  data.push(text(co.footer, { textAlign: 'center', fontSize: `${base - 2}px` }));
+  data.push(spacer(10));
+  return data;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Template 2: detailed                                                      */
+/* ------------------------------------------------------------------------- */
+
+function buildDetailed(doc, company, { paper, formatMoney }) {
+  const narrow = paper === '58mm';
+  const base = narrow ? 10 : 12;
+  const small = base - 2;
+  const co = companyBlock(company);
+  const t = computeThermalTotals(doc.items);
+  const data = [];
+
+  data.push(text(co.name.toUpperCase(), { fontWeight: '700', textAlign: 'center', fontSize: `${base + 6}px` }));
+  if (co.address) data.push(text(co.address, { textAlign: 'center', fontSize: `${small}px` }));
+  if (co.phone) data.push(text(`Tel: ${co.phone}`, { textAlign: 'center', fontSize: `${small}px` }));
+  if (co.email) data.push(text(co.email, { textAlign: 'center', fontSize: `${small}px` }));
+  if (co.vat) data.push(text(`VAT No: ${co.vat}`, { textAlign: 'center', fontSize: `${small}px` }));
+  data.push(divider(false));
+
+  data.push(text(doc.label, { fontWeight: '700', textAlign: 'center', fontSize: `${base + 3}px` }));
+  data.push({
+    type: 'table',
+    style: { border: 'none', width: '100%' },
+    tableBody: [
+      [cell('No:', { fontSize: `${small}px` }), cell(doc.number, { fontSize: `${small}px`, textAlign: 'right', fontWeight: '700' })],
+      [cell('Date:', { fontSize: `${small}px` }), cell(`${doc.date} ${doc.time}`, { fontSize: `${small}px`, textAlign: 'right' })],
+      [cell('Customer:', { fontSize: `${small}px` }), cell(doc.party, { fontSize: `${small}px`, textAlign: 'right' })],
+      ...(doc.reference
+        ? [[cell('Ref:', { fontSize: `${small}px` }), cell(doc.reference, { fontSize: `${small}px`, textAlign: 'right' })]]
+        : []),
+    ],
+    tableBodyStyle: { border: 'none', padding: '1px 0' },
+  });
+  data.push(divider());
+
+  // 58 mm is too narrow for a Price column
+  const header = narrow ? ['Item', 'Qty', 'Total'] : ['Item', 'Qty', 'Price', 'Total'];
+  data.push({
+    type: 'table',
+    style: { border: 'none', width: '100%' },
+    tableHeader: header,
+    tableHeaderStyle: {
+      borderBottom: '1px solid #000',
+      fontSize: `${small}px`,
+      fontWeight: '700',
+      textAlign: 'left',
+    },
+    tableBody: t.lines.map((l) => {
+      const name = cell(`${l.name}${l.discPct ? ` (-${l.discPct}%)` : ''}`, { fontSize: `${base}px`, textAlign: 'left' });
+      const qty = cell(qtyText(l.qty), { fontSize: `${base}px`, textAlign: 'left' });
+      const price = cell(formatMoney(l.price), { fontSize: `${base}px`, textAlign: 'right', whiteSpace: 'nowrap' });
+      const total = cell(formatMoney(l.net), { fontSize: `${base}px`, textAlign: 'right', whiteSpace: 'nowrap' });
+      return narrow ? [name, qty, total] : [name, qty, price, total];
+    }),
+    tableBodyStyle: { border: 'none', padding: '2px 0', borderBottom: '0.5px dotted #888' },
+  });
+  data.push(divider());
+
+  const totalsRows = [];
+  if (t.discount > 0) {
+    totalsRows.push([cell('Subtotal', { fontSize: `${base}px` }), cell(formatMoney(t.gross), { fontSize: `${base}px`, textAlign: 'right' })]);
+    totalsRows.push([cell('Discount', { fontSize: `${base}px` }), cell(`-${formatMoney(t.discount)}`, { fontSize: `${base}px`, textAlign: 'right' })]);
+  }
+  totalsRows.push([
+    cell('TOTAL', { fontWeight: '700', fontSize: `${base + 4}px` }),
+    cell(formatMoney(t.total), { fontWeight: '700', fontSize: `${base + 4}px`, textAlign: 'right' }),
+  ]);
+  if (t.vat > 0) {
+    totalsRows.push([
+      cell('VAT included', { fontSize: `${small}px` }),
+      cell(formatMoney(t.vat), { fontSize: `${small}px`, textAlign: 'right' }),
+    ]);
+  }
+  data.push({
+    type: 'table',
+    style: { border: 'none', width: '100%' },
+    tableBody: totalsRows,
+    tableBodyStyle: { border: 'none', padding: '1px 0' },
+  });
+
+  if (doc.notes) {
+    data.push(divider());
+    data.push(text(doc.notes, { fontSize: `${small}px`, textAlign: 'left' }));
+  }
+
+  data.push(divider(false));
+  data.push(text(co.footer, { textAlign: 'center', fontSize: `${small}px`, fontStyle: 'italic' }));
+  if (doc.hasNumber) {
+    data.push({
+      type: 'barCode',
+      value: doc.number,
+      height: 36,
+      width: narrow ? 1 : 1.5,
+      displayValue: true,
+      fontsize: 10,
+    });
+  }
+  data.push(spacer(10));
+  return data;
+}
+
+/* ------------------------------------------------------------------------- */
+/* Public API                                                                */
+/* ------------------------------------------------------------------------- */
+
+/**
+ * @param {object} tx          draft or saved transaction (lineItems | items, number, type, ...)
+ * @param {object} company     settings values (company_name, company_address, ...)
+ * @param {object} opts        { template: 'compact'|'detailed', paper: '80mm'|'58mm',
+ *                               formatMoney: (n) => string, partyName?: string }
+ * @returns {object[]} electron-pos-printer data array
+ */
+export function buildThermalReceipt(tx, company = {}, opts = {}) {
+  const template = opts.template === 'detailed' ? 'detailed' : 'compact';
+  const paper = opts.paper === '58mm' ? '58mm' : '80mm';
+  const formatMoney = opts.formatMoney || ((n) => Number(n || 0).toFixed(2));
+
+  const items = (tx?.lineItems || tx?.items || []).filter((i) => i && (Number(i.quantity) || 0) > 0);
+  const hasNumber = !!tx?.number;
+  const issued = tx?.issuedAt || tx?.issued_at || tx?.created_at;
+
+  const doc = {
+    items,
+    label: DOC_LABELS[tx?.type] || 'RECEIPT',
+    number: hasNumber ? String(tx.number) : 'DRAFT',
+    hasNumber,
+    date: formatDate(issued),
+    time: formatTime(tx?.created_at),
+    party: opts.partyName || (tx?.type === 'purchase_order' ? 'Supplier' : 'Walk-in Customer'),
+    reference: tx?.manualReference || tx?.manual_reference || '',
+    notes: tx?.notes || '',
+  };
+
+  const ctx = { paper, formatMoney };
+  const data = template === 'detailed' ? buildDetailed(doc, company, ctx) : buildCompact(doc, company, ctx);
+  // The payload crosses IPC, so make sure it is plain JSON (no Vue proxies)
+  return JSON.parse(JSON.stringify(data));
+}
+
+/** A small fake sale used by the "Test print" button. */
+export function sampleTransaction() {
+  return {
+    type: 'invoice',
+    number: 'TEST-0001',
+    created_at: new Date().toISOString(),
+    issuedAt: new Date().toISOString().slice(0, 10),
+    notes: 'Printer test - not a real sale',
+    lineItems: [
+      { name: 'Claw hammer 16oz', quantity: 1, unit_price: 85, discount_pct: 0, tax_rate: 15 },
+      { name: 'Wood screws 4x40 (box)', quantity: 3, unit_price: 24.5, discount_pct: 10, tax_rate: 15 },
+      { name: 'Masking tape', quantity: 2, unit_price: 12, discount_pct: 0, tax_rate: 15 },
+    ],
+  };
+}
diff --git a/src-electron/thermal-printer.js b/src-electron/thermal-printer.js
new file mode 100644
index 0000000..6a6c948
--- /dev/null
+++ b/src-electron/thermal-printer.js
@@ -0,0 +1,64 @@
+/**
+ * Thermal receipt printing (main process).
+ *
+ * Wire-up in electron-main.js (module level, NOT inside createWindow):
+ *   import { registerThermalPrinter } from './thermal-printer';
+ *   registerThermalPrinter(() => mainWindow);
+ */
+import { ipcMain, BrowserWindow } from 'electron';
+import * as posPrinterModule from 'electron-pos-printer';
+
+// Works whether the bundler hands us CJS-style or ESM-style exports
+const PosPrinter = posPrinterModule.PosPrinter || posPrinterModule.default?.PosPrinter;
+
+const ALLOWED_PAPER = ['58mm', '80mm'];
+
+function sanitizeOptions(raw = {}) {
+  const options = {
+    preview: false,
+    margin: '0 0 0 0',
+    timeOutPerLine: 400,
+    pageSize: ALLOWED_PAPER.includes(raw.pageSize) ? raw.pageSize : '80mm',
+    silent: raw.silent !== false,
+    copies: Math.min(5, Math.max(1, Math.floor(Number(raw.copies) || 1))),
+  };
+  if (typeof raw.printerName === 'string' && raw.printerName.trim()) {
+    options.printerName = raw.printerName.trim();
+  }
+  if (raw.preview === true) {
+    options.preview = true;
+    options.silent = false;
+  }
+  return options;
+}
+
+export function registerThermalPrinter(getWindow) {
+  const windowOf = () => (typeof getWindow === 'function' ? getWindow() : null) || BrowserWindow.getAllWindows()[0];
+
+  ipcMain.handle('thermal:list-printers', async () => {
+    try {
+      const win = windowOf();
+      if (!win) return [];
+      const printers = await win.webContents.getPrintersAsync();
+      return printers.map((p) => ({
+        name: p.name,
+        displayName: p.displayName || p.name,
+        isDefault: !!p.isDefault,
+      }));
+    } catch (err) {
+      return [];
+    }
+  });
+
+  ipcMain.handle('thermal:print', async (_event, payload) => {
+    try {
+      if (!PosPrinter) throw new Error('electron-pos-printer is not installed (run: npm install electron-pos-printer)');
+      const data = payload?.data;
+      if (!Array.isArray(data) || !data.length) throw new Error('Nothing to print');
+      await PosPrinter.print(data, sanitizeOptions(payload?.options));
+      return { ok: true };
+    } catch (err) {
+      return { ok: false, error: err?.message || String(err) };
+    }
+  });
+}
diff --git a/src-electron/thermal-preload.js b/src-electron/thermal-preload.js
new file mode 100644
index 0000000..eeb3b0a
--- /dev/null
+++ b/src-electron/thermal-preload.js
@@ -0,0 +1,13 @@
+/**
+ * Exposes window.thermalPrinter to the renderer.
+ *
+ * Wire-up in electron-preload.js:
+ *   import { exposeThermalPrinter } from './thermal-preload';   // or require()
+ *   exposeThermalPrinter(contextBridge, ipcRenderer);
+ */
+export function exposeThermalPrinter(contextBridge, ipcRenderer) {
+  contextBridge.exposeInMainWorld('thermalPrinter', {
+    listPrinters: () => ipcRenderer.invoke('thermal:list-printers'),
+    print: (payload) => ipcRenderer.invoke('thermal:print', payload),
+  });
+}
diff --git a/src/components/transactions/ThermalPrintButton.vue b/src/components/transactions/ThermalPrintButton.vue
new file mode 100644
index 0000000..0eb7a4f
--- /dev/null
+++ b/src/components/transactions/ThermalPrintButton.vue
@@ -0,0 +1,212 @@
+<template>
+  <div class="thermal-print">
+    <q-btn-group flat>
+      <q-btn
+        color="primary"
+        icon="receipt_long"
+        no-caps
+        :label="`Print receipt (${templateLabel})`"
+        :loading="printing"
+        :disable="!hasItems"
+        @click="printTransaction"
+      >
+        <q-tooltip>Print on the thermal receipt printer</q-tooltip>
+      </q-btn>
+      <q-btn color="primary" icon="settings" dense @click="openSettings">
+        <q-tooltip>Thermal printer settings</q-tooltip>
+      </q-btn>
+    </q-btn-group>
+
+    <q-dialog v-model="showSettings">
+      <q-card style="min-width: 420px">
+        <q-card-section class="text-h6">Thermal printer</q-card-section>
+
+        <q-card-section class="q-gutter-md">
+          <q-select
+            v-model="prefs.printerName"
+            :options="printerOptions"
+            emit-value
+            map-options
+            clearable
+            filled
+            label="Receipt printer"
+            hint="Leave empty to use the Windows default printer"
+          >
+            <template #after>
+              <q-btn flat dense round icon="refresh" @click="loadPrinters"><q-tooltip>Refresh list</q-tooltip></q-btn>
+            </template>
+          </q-select>
+
+          <div>
+            <div class="text-caption text-grey q-mb-xs">Template</div>
+            <q-btn-toggle
+              v-model="prefs.template"
+              no-caps
+              unelevated
+              toggle-color="primary"
+              :options="templateOptions"
+            />
+            <div class="text-caption text-grey q-mt-xs">{{ templateHint }}</div>
+          </div>
+
+          <div>
+            <div class="text-caption text-grey q-mb-xs">Paper width</div>
+            <q-btn-toggle
+              v-model="prefs.paper"
+              no-caps
+              unelevated
+              toggle-color="primary"
+              :options="paperOptions"
+            />
+          </div>
+
+          <q-input v-model.number="prefs.copies" type="number" min="1" max="5" filled label="Copies" />
+          <q-toggle v-model="prefs.silent" label="Print silently (no Windows print dialog)" />
+        </q-card-section>
+
+        <q-card-actions align="right">
+          <q-btn flat no-caps label="Test print" :loading="testing" @click="testPrint" />
+          <q-btn color="primary" no-caps label="Done" v-close-popup />
+        </q-card-actions>
+      </q-card>
+    </q-dialog>
+  </div>
+</template>
+
+<script setup>
+import { ref, reactive, computed, watch } from 'vue';
+import { useQuasar } from 'quasar';
+import { useSettingsStore } from 'src/stores/settings';
+import { useCustomersStore } from 'src/stores/customers';
+import { useCurrency } from 'src/composables/useCurrency';
+import {
+  THERMAL_TEMPLATES,
+  THERMAL_PAPER_WIDTHS,
+  buildThermalReceipt,
+  sampleTransaction,
+} from 'src/services/thermal/templates';
+
+const props = defineProps({
+  // The draft from the transactions store, or a saved transaction ({ items | lineItems, number, ... })
+  transaction: { type: Object, required: true },
+});
+
+const $q = useQuasar();
+const settingsStore = useSettingsStore();
+const customersStore = useCustomersStore();
+const { format } = useCurrency();
+
+const STORAGE_KEY = 'thermal-print-prefs';
+
+function loadPrefs() {
+  const defaults = { printerName: '', template: 'compact', paper: '80mm', copies: 1, silent: true };
+  try {
+    return { ...defaults, ...JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') };
+  } catch (err) {
+    return defaults;
+  }
+}
+
+const prefs = reactive(loadPrefs());
+watch(prefs, (value) => {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
+  } catch (err) {
+    // storage unavailable - preferences just won't persist
+  }
+}, { deep: true });
+
+const showSettings = ref(false);
+const printing = ref(false);
+const testing = ref(false);
+const printers = ref([]);
+
+const templateOptions = THERMAL_TEMPLATES.map((t) => ({ label: t.label, value: t.value }));
+const paperOptions = THERMAL_PAPER_WIDTHS;
+const templateLabel = computed(() => THERMAL_TEMPLATES.find((t) => t.value === prefs.template)?.label || 'Compact');
+const templateHint = computed(() => THERMAL_TEMPLATES.find((t) => t.value === prefs.template)?.hint || '');
+
+const printerOptions = computed(() =>
+  printers.value.map((p) => ({ label: p.isDefault ? `${p.displayName} (default)` : p.displayName, value: p.name })),
+);
+
+const company = computed(() => settingsStore.values || {});
+const lineItems = computed(() => props.transaction?.lineItems || props.transaction?.items || []);
+const hasItems = computed(() => lineItems.value.some((i) => Number(i.quantity) > 0));
+
+function bridge() {
+  if (!window.thermalPrinter) {
+    $q.notify({
+      type: 'negative',
+      message: 'Thermal printing is only available in the desktop app (printer bridge not found).',
+    });
+    return null;
+  }
+  return window.thermalPrinter;
+}
+
+async function loadPrinters() {
+  if (!window.thermalPrinter) return;
+  try {
+    printers.value = await window.thermalPrinter.listPrinters();
+  } catch (err) {
+    printers.value = [];
+  }
+}
+
+function openSettings() {
+  showSettings.value = true;
+  loadPrinters();
+}
+
+function partyNameFor(tx) {
+  const id = tx?.customerId ?? tx?.customer_id;
+  if (id === null || id === undefined || id === '') return tx?.customer_name || '';
+  const customer = customersStore.items.find((c) => c.id === id);
+  return customer?.name || tx?.customer_name || '';
+}
+
+async function send(tx, flagRef) {
+  const api = bridge();
+  if (!api) return;
+  flagRef.value = true;
+  try {
+    const data = buildThermalReceipt(tx, company.value, {
+      template: prefs.template,
+      paper: prefs.paper,
+      formatMoney: (n) => format(n),
+      partyName: partyNameFor(tx),
+    });
+    const result = await api.print({
+      data,
+      options: {
+        printerName: prefs.printerName || '',
+        pageSize: prefs.paper,
+        copies: prefs.copies,
+        silent: prefs.silent,
+      },
+    });
+    if (result?.ok) {
+      $q.notify({ type: 'positive', message: 'Sent to thermal printer', timeout: 1200 });
+    } else {
+      $q.notify({ type: 'negative', message: result?.error || 'Thermal print failed' });
+    }
+  } catch (err) {
+    $q.notify({ type: 'negative', message: err.message || 'Thermal print failed' });
+  } finally {
+    flagRef.value = false;
+  }
+}
+
+function printTransaction() {
+  if (!hasItems.value) {
+    $q.notify({ type: 'warning', message: 'Add at least one item first' });
+    return;
+  }
+  return send(props.transaction, printing);
+}
+
+function testPrint() {
+  return send(sampleTransaction(), testing);
+}
+</script>
