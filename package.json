    "autoprefixer": "^10.4.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
